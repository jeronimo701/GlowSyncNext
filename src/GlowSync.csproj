<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\glowsync.ico</ApplicationIcon>
    <AssemblyName>GlowSync.Next</AssemblyName>
    <RootNamespace>GlowSync</RootNamespace>
    <Version>0.3.3</Version>
    <Product>GlowSync Next</Product>
    <Description>Подсветка монитора: синхронизация с экраном, музыка, эффекты</Description>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <NoWarn>$(NoWarn);MVVMTK0045;CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Audio\*.cs;Capture\*.cs;Device\*.cs;Config\*.cs" />
    <Compile Remove="Core\ColorMath.cs;Core\Effects.cs;Core\Engine.cs;Core\LayoutBuilder.cs;Core\FrameMetric.cs;Core\PlaybackEvidence.cs;Core\ProfileClassifier.cs" />
    <Compile Remove="Platform\FrameTimer.cs;Platform\MonitorPower.cs;Platform\Log.cs;Platform\DisplaySignal.cs" />
    <ProjectReference Include="..\engine\GlowSync.Engine.csproj" />
    <Resource Include="Assets\*.ico" />
    <InternalsVisibleTo Include="GlowSync.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
